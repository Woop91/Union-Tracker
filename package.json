{
  "name": "solidbase-dashboard",
  "version": "4.56.2",
  "description": "SolidBase — Modular Union Steward Dashboard",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "build:prod": "node build.js --prod --minify",
    "lint": "eslint \"src/**/*.gs\"",
    "lint:fix": "eslint \"src/**/*.gs\" --fix",
    "test": "npm run lint && npm run build:prod && jest --verbose",
    "test:unit": "jest --verbose",
    "test:webapp": "jest test/19_WebDashAuth.test.js test/20_WebDashConfigReader.test.js test/21_WebDashDataService.test.js test/22_WebDashApp.test.js test/23_PortalSheets.test.js test/24_WeeklyQuestions.test.js test/26_QAForum.test.js test/27_TimelineService.test.js test/28_FailsafeService.test.js test/29_Migrations.test.js test/auth-denial.test.js test/negative-paths.test.js --verbose",
    "coverage": "node scripts/run-coverage.js",
    "ci": "npm run clean && npm run lint && npm run build:prod && npm run test:unit",
    "clean": "node build.js --clean",
    "test:guards": "jest test/deploy-guards.test.js test/spa-integrity.test.js --verbose --no-coverage",
    "test:atlas": "jest test/union-atlas-data.test.js --verbose --runInBand",
    "test:atlas:e2e": "playwright test --config playwright.atlas.config.js",
    "contrast:audit": "node scripts/contrast-audit.mjs",
    "data:import": "node scripts/import-union-atlas-data.mjs",
    "data:geocode": "node scripts/geocode-union-headquarters.mjs",
    "data:build": "node scripts/build-union-atlas-data.mjs && node scripts/build-union-atlas-page.mjs",
    "data:verify": "node scripts/verify-union-atlas-data.mjs",
    "data:freshness": "node scripts/check-union-atlas-freshness.mjs",
    "atlas:theme": "node scripts/build-union-atlas-theme.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry",
    "deploy:dev": "npm run lint && npm run build && clasp push --force",
    "open": "clasp open",
    "prepare": "husky",
    "check:scopes": "node scripts/check-scope-change.js"
  },
  "keywords": [
    "google-apps-script",
    "google-sheets",
    "union",
    "grievance",
    "dashboard"
  ],
  "author": "Dashboard Team",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@google/clasp": "^3.3.0",
    "@playwright/test": "^1.62.0",
    "@types/google-apps-script": "^1.0.83",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@hono/node-server": "^2.0.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Woop91/SolidBase.git"
  },
  "lint-staged": {
    "src/**/*.gs": [
      "eslint"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
